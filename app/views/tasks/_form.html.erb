<%= form_with model: task, local: true do |form| %>
  <% if task.errors.any? %>
    <div>
      <p>入力内容を確認してください。</p>
      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <%= form.label :title, "課題名" %><br>
    <%= form.text_field :title %>
  </p>

  <p>
    <%= form.label :subject, "科目名" %><br>
    <%= form.text_field :subject %>
  </p>

  <p>
    <%= form.label :deadline, "提出期限" %><br>
    <%= form.date_field :deadline %>
  </p>

  <p>
    <%= form.label :memo, "メモ" %><br>
    <%= form.text_area :memo, rows: 5 %>
  </p>

  <p><%= form.submit "保存する" %></p>
<% end %>