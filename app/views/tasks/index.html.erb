<div class="page-heading">
  <div>
    <h1>課題一覧</h1>
    <p class="help-text">提出期限が早い順に表示しています。</p>
  </div>

  <%= link_to "＋ 課題を登録", new_task_path, class: "button" %>
</div>

<section class="card">
  <% if @tasks.any? %>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">課題名</th>
            <th scope="col">科目名</th>
            <th scope="col">提出期限</th>
            <th scope="col">操作</th>
          </tr>
        </thead>

        <tbody>
          <% @tasks.each do |task| %>
            <tr>
              <td><%= link_to task.title, task_path(task) %></td>
              <td><%= task.subject %></td>

              <td>
                <%= task.deadline&.strftime("%Y/%m/%d") %>

                <% if task.deadline.present? && task.deadline < Date.current %>
                  <span class="badge overdue">期限超過</span>
                <% elsif task.deadline == Date.current %>
                  <span class="badge today">本日締切</span>
                <% end %>
              </td>

              <td>
                <%= link_to "編集", edit_task_path(task),
                            class: "button secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="empty-message">
      課題はまだありません。「＋ 課題を登録」から追加してください。
    </p>
  <% end %>
</section>